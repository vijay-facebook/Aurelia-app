# Copy this file to ".env" and set your own values.

PORT=3000

# Password for the /admin panel. REQUIRED in production - the server refuses to start with the default.
ADMIN_PASSWORD=change-me-to-a-strong-password

# Any long random text (used to sign login cookies). REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: where site content and uploaded photos/videos are stored.
# On hosts that erase files on every deploy, point these at a persistent disk / volume.
# DATA_DIR=/var/data/site
# UPLOADS_DIR=/var/data/uploads
