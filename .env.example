# Copy this file to ".env" and set your own values.

PORT=3000

# Supabase project (server-side only).
SUPABASE_URL=https://hcrypnkcinvxattgfzwa.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Server-only secret. NEVER expose this in VITE_* variables or browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret

# One-time key used to bootstrap the first administrator.
ADMIN_SIGNUP_SECRET=replace-with-a-long-random-one-time-secret

# Public site origin used for password reset redirects.
PUBLIC_APP_URL=http://localhost:3000

# Optional persistent storage locations.
# DATA_DIR=/var/data/site
# UPLOADS_DIR=/var/data/uploads

# Google Gemini API key (server-side only).
# GEMINI_API_KEY=your-gemini-api-key
